<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action — appears in the Action (⚙) dropdown on hr.payslip list views -->
    <record id="action_export_bank_data_csv" model="ir.actions.server">
        <field name="name">Export Paymaster XLSX</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_export_bank_data_csv()</field>
    </record>
</odoo>
